<Project>
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Authors>Bunny</Authors>
		<!-- Version for local builds; the publish workflow overrides it with the release tag. Keep it in step with the top changelog entry. -->
		<Version>7.5.7.10</Version>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="System.Numerics" />
		<Using Include="System.Reflection" />
	</ItemGroup>
</Project>